# Preserved legacy protections
# Real configuration and credentials, at any depth.
config*.json
!config.example.json
!config.*.example.json
!config.schema.json
*.local.json
.env
.env.*
!.env.example
secrets/
credentials/
private/
*.key
*.pem
*.p12
*.pfx

# Account data and runtime output. Put custom output filenames in data/.
data/
results/
outputs/
holdings*.json
holdings*.csv
summary*.json
accounts*.json
*.log
*.log.*

# Temporary files, session exports, APKs, and private delivery archives.
work/
tmp/
*.tmp
*.bak
*.mmkv
*.crc
*.apk
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Python and tooling.
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Editors and operating systems.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Python caches, test output, and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
*.egg-info/
build/
dist/

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
config/*.json
!config/*.example.json
certs/*.crt
certs/*.key
certs/*.pem

# Runtime state and generated output
logs/*
!logs/.gitkeep
work/*
!work/.gitkeep
android/*.jar
nohup.out

# Local agent, editor, and OS metadata
.agents/
.codex/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db


